{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /*
  Same as Hugo's built-in sitemap, plus <lastmod>.

  The pages themselves carry no dates (the CV and publication lists live in
  data/*.yaml), so Hugo's .Lastmod is empty. The deploy workflow therefore
  passes the commit date of the last content/ or data/ change as
  params.contentLastmod, and that is used as the fallback here — telling search
  engines when the site's content actually changed.
*/ -}}
{{ $fallback := site.Params.contentLastmod }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Pages }}
  {{- $lastmod := "" }}
  {{- if not .Lastmod.IsZero }}{{ $lastmod = .Lastmod.Format "2006-01-02T15:04:05-07:00" }}
  {{- else if $fallback }}{{ $lastmod = $fallback }}{{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- with $lastmod }}
    <lastmod>{{ . | safeHTML }}</lastmod>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}" />
    {{- end }}
    {{- end }}
  </url>
  {{- end }}
</urlset>
