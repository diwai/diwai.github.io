{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Same as Hugo's built-in sitemap index, plus <lastmod> (see layouts/sitemap.xml). */ -}}
{{ $fallback := site.Params.contentLastmod }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range . }}
  {{- $lastmod := "" }}
  {{- if not .Lastmod.IsZero }}{{ $lastmod = .Lastmod.Format "2006-01-02T15:04:05-07:00" }}
  {{- else if $fallback }}{{ $lastmod = $fallback }}{{ end }}
  <sitemap>
    <loc>{{ .SitemapAbsURL }}</loc>
    {{- with $lastmod }}
    <lastmod>{{ . | safeHTML }}</lastmod>
    {{- end }}
  </sitemap>
  {{- end }}
</sitemapindex>
